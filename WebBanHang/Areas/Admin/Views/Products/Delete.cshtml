@model WebBanHang.Models.Product

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<style>
    .form-group {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .btn-primary {
        padding: 8px 16px;
        border-radius: 5px;
        background-color: #4CAF50; /* Xanh lá nhạt */
        color: white;
        border: none;
        transition: background-color 0.3s ease, transform 0.2s ease;
    }

        .btn-primary:hover {
            background-color: #45a049; /* Xanh lá đậm hơn khi hover */
            transform: scale(1.05); /* Hiệu ứng phóng to nhẹ */
        }

        .btn-primary:active {
            background-color: #3e8e41; /* Xanh đậm khi nhấn */
            transform: scale(0.98); /* Hiệu ứng nhấn nhẹ */
        }
</style>

<h2 class="bg-success">XÓA SẢN PHẨM</h2>
<h4 class="alert-danger">Bạn thực sự muốn xóa sản phẩm này à ?</h4>
@Html.Partial("PVProdInfo", Model)

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-group">
        <div class="col-md-offset-4 col-md-10">
            <input type="submit" value="Xóa" class="btn btn-primary" />
            @*@Html.ActionLink("Xóa", "Delete", new { id = Model.ProductID }, new { @class = "btn btn-primary " })*@
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary " })
        </div>
    </div>
}
