


@model WebBanHang.Models.ViewModel.RegisterVM
@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_LayoutDivMain.cshtml";


}
<style>
    .container-center {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background-color: #f9f9f9;
        padding: 20px;
    }

    .form-horizontal {
        background: #fff;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        width: 100%;
        max-width: 600px;
    }

    .form-title {
        text-align: center;
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    .control-label {
        display: block;
        margin-bottom: 5px;
    }

    .accountbtn {
        width: 100%;
        padding: 10px;
        background-color: #17a2b8;
        color: #fff;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
    }

        .accountbtn:hover {
            background-color: #138496;
        }
</style>

<div class="container-center">
    @using (Html.BeginForm("Register", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="form-group">
                <h2 class="form-title">Đăng ký tài khoản</h2>
            </div>
            @* Họ tên khách hàng *@
            <div class="form-group">
                @Html.LabelFor(model => model.CustomerName, new { @class = "control-label" })
                <div>
                    @Html.EditorFor(model => model.CustomerName, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.CustomerName)
                </div>
            </div>
            @* Số điện thoại khách hàng *@
            <div class="form-group">
                @Html.LabelFor(model => model.CustomerPhone, new { @class = "control-label" })
                <div>
                    @Html.EditorFor(model => model.CustomerPhone, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.CustomerPhone)
                </div>
            </div>
            @* Email khách hàng *@
            <div class="form-group">
                @Html.LabelFor(model => model.CustomerEmail, new { @class = "control-label" })
                <div>
                    @Html.EditorFor(model => model.CustomerEmail, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.CustomerEmail)
                </div>
            </div>
            @* Địa chỉ khách hàng *@
            <div class="form-group">
                @Html.LabelFor(model => model.CustomerAddress, new { @class = "control-label" })
                <div>
                    @Html.EditorFor(model => model.CustomerAddress, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.CustomerAddress)
                </div>
            </div>
            @* Tên đăng nhập *@
            <div class="form-group">
                @Html.LabelFor(model => model.Username, new { @class = "control-label" })
                <div>
                    @Html.EditorFor(model => model.Username, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
                </div>
            </div>
            @* Mật khẩu *@
            <div class="form-group">
                @Html.LabelFor(model => model.Password, new { @class = "control-label" })
                <div>
                    @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                </div>
            </div>
            @* Xác nhận mật khẩu *@
            <div class="form-group">
                @Html.LabelFor(model => model.ConfirmPassword, new { @class = "control-label" })
                <div>
                    @Html.EditorFor(model => model.ConfirmPassword, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                <div>
                    <input type="submit" value="Đăng ký" class="btn btn-info accountbtn" />
                    <p>Bạn đã có tài khoản? <a href="@Url.Action("Login","Account",null)">Đăng nhập</a></p>
                </div>
            </div>
        </div>
    }
</div>

