@model WebBanHang.Models.ViewModel.ProductDetailsVM
@using PagedList.Mvc
<link href="~/Content/myStyle/CustomerDetail.css" rel="stylesheet" />

@if (Model.TopProduct != null && Model.TopProduct.Any())
{
    <section class="container-fluid listProduct">
        <h4 style="font-weight:bold">Sản phẩm Top</h4>
        <ul class="list-container">
            @foreach (var product in Model.TopProduct)
            {
                <li class="lproduct-item">
                    <div>
                        <a href="@Url.Action("ProductDetail","Home",new { id = product.ProductID })">
                            <img src="@Html.DisplayFor(modelItem => product.ProductImage)" />
                        </a>
                    </div>
                    <div>
                        <h5> @Html.DisplayFor(modleItem => product.ProductName)</h5>
                        <p class="prodSale">@Html.DisplayFor(modelItem => product.ProductPrice)</p>
                    </div>
                </li>
            }
        </ul>
    </section>
    <!-- hiển thị phân trang-->
    <div class="pagination-container">
        @Html.PagedListPager(Model.TopProduct, page => Url.Action("ProductDetail", new
    {
       id = Model.product.ProductID,
       quantity = Model.quantity,
       page
    }))
    </div>
}
